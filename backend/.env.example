# ==============================================
# LiveCar Platform - Backend Environment Config
# ==============================================

# ----------------
# Database
# ----------------
DATABASE_URL=postgresql://user:password@localhost:5432/livecar

# ----------------
# JWT Authentication
# ----------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ----------------
# Server
# ----------------
PORT=3000
NODE_ENV=development

# ----------------
# Streaming (Mux)
# ----------------
# Obtenha em: https://dashboard.mux.com/
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# =====================================
# IA - ESCOLHA UMA DAS OPÇÕES ABAIXO
# =====================================

# -------------------------------------
# OPÇÃO 1: Ollama (GRATUITO) ⭐ RECOMENDADO
# -------------------------------------
# Setup: https://ollama.com/
# Totalmente gratuito e ilimitado!
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_TEXT_MODEL=mistral:7b

# Transcrição local (gratuita)
TRANSCRIPTION_PROVIDER=whisper-local
WHISPER_PATH=/usr/local/bin/whisper.cpp
WHISPER_MODEL=/usr/local/share/whisper/models/ggml-medium.bin

# -------------------------------------
# OPÇÃO 2: OpenAI (PAGO)
# -------------------------------------
# Use apenas se precisar de qualidade premium
# Custos: ~$0.01-0.03 por imagem, ~$0.006 por minuto de áudio
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_VISION_MODEL=gpt-4-vision-preview
# OPENAI_TEXT_MODEL=gpt-4
# TRANSCRIPTION_PROVIDER=openai

# -------------------------------------
# OPÇÃO 3: LocalAI (GRATUITO)
# -------------------------------------
# Compatível com API OpenAI, roda localmente
# Setup: https://localai.io/
# AI_PROVIDER=localai
# LOCALAI_URL=http://localhost:8080/v1

# ----------------
# CORS
# ----------------
CORS_ORIGIN=http://localhost:5173

# ----------------
# File Upload
# ----------------
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# =====================================
# 💡 DICA: COMECE SEM CUSTOS!
# =====================================
# 
# Para usar IA gratuitamente:
# 1. Instale Ollama: curl -fsSL https://ollama.com/install.sh | sh
# 2. Baixe os modelos: 
#    ollama pull llava:13b
#    ollama pull mistral:7b
# 3. Use AI_PROVIDER=ollama
# 
# Documentação completa: docs/FREE-AI-SETUP.md
# =====================================
